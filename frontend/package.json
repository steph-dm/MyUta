{
  "name": "myuta-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "Frontend for MyUta — a karaoke session and score tracking application",
  "author": "steph-dm",
  "license": "SEE LICENSE IN ../LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/steph-dm/MyUta.git",
    "directory": "frontend"
  },
  "dependencies": {
    "@apollo/client": "^3.14.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "graphql": "^16.12.0",
    "heic-to": "^1.6.7",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/precompress.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "graphql-codegen --config codegen.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "npm run codegen && npm run typecheck && npm run lint && npm run format:check && npm run check:i18n && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "type": "module",
  "packageManager": "npm@11.21.3",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  }
}
