# Used by docker compose (make up). For running the backend directly see backend/.env.example.

# --- database ---------------------------------------------------------------------------
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=myuta

# --- backend ---------------------------------------------------------------------------
# production (default): Secure cookies, no GraphQL playground, real e-mails.
APP_ENV=production
# At least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=
# Browser origin(s) of the app, comma-separated; the first one is used in e-mailed links.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000

# --- optional features (empty = disabled, and hidden in the UI) ---------------------------
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Password reset / e-mail confirmation
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- analytics (Umami, cookieless; empty = disabled) --------------------------------------
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
# Origin of the Umami script, added to the Content-Security-Policy, e.g. https://cloud.umami.is
CSP_ANALYTICS_ORIGIN=
